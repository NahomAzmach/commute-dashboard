# Vercel AI Gateway key (Settings -> AI Gateway -> API Keys). Powers both the
# vision description step (openai/gpt-4o-mini) and the JEV classifier.
AI_GATEWAY_API_KEY=

# ntfy.sh topic name (pick any unique, hard-to-guess string). Install the ntfy
# app and subscribe to this same topic to receive push notifications.
NTFY_TOPIC=

# Shared secret so only Vercel Cron (or you, manually) can trigger the check
# endpoint. Any random string.
CRON_SECRET=

# Upstash Redis REST credentials (set these locally too; archive API rate
# limiting requires Redis to be reachable).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Camera image archive pilot: private Cloudflare R2 bucket + Supabase pgvector.
# Keep these server-only; never prefix them with NEXT_PUBLIC_.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Local EmbeddingGemma 2 worker for explicit camera indexing and text search.
# This stays server-side; do not use NEXT_PUBLIC_ variables.
CAMERA_EMBEDDING_URL=http://127.0.0.1:8790
CAMERA_EMBEDDING_API_KEY=
